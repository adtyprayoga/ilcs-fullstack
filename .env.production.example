# Salin file ini menjadi .env.production di server, lalu isi nilainya.
# Jangan commit .env.production: sudah ada di .gitignore.
#
#   cp .env.production.example .env.production
#   openssl rand -base64 32        # untuk SESSION_SECRET
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Menandai lingkungan produksi. scripts/backup.sh memakai nilai ini untuk
# mewajibkan tujuan off-site.
NODE_ENV=production

POSTGRES_USER=musicpedia
POSTGRES_PASSWORD=ubah-password-database-yang-kuat
POSTGRES_DB=musicpedia

# Minimal 32 karakter. Jangan pakai nilai contoh ini.
SESSION_SECRET=ubah-dengan-hasil-openssl-rand-base64-32

# Akun Admin dibuat lewat `docker compose ... run --rm backend node backend/src/seed.ts`
# atau `npm run seed` dengan DATABASE_URL yang menunjuk database produksi.
ADMIN_EMAIL=admin@musicpedia.id
ADMIN_PASSWORD=ubah-password-admin-yang-kuat

# Midtrans. Server key hanya ada di server. Kosongkan untuk demo tanpa gateway;
# checkout akan gagal dengan pesan yang jelas sampai kunci diisi.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false

# RabbitMQ untuk antrean Email Selamat Datang. Jangan pakai guest/guest.
# Nilai ini disusun langsung ke AMQP_URL, jadi hindari karakter @ : / % # ?
# di kata sandi (pakai misalnya `openssl rand -hex 24`).
RABBITMQ_USER=musicpedia
RABBITMQ_PASSWORD=ubah-password-rabbitmq-yang-kuat

# Worker email menolak start bila kredensial SMTP Mailtrap atau APP_URL kosong.
# Kredensial ada di Mailtrap > Sandboxes > inbox > Integration > SMTP.
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
EMAIL_PENGIRIM=MusicPedia <no-reply@musicpedia.id>
# Alamat publik MusicPedia; dipakai sebagai tautan di Email Selamat Datang.
APP_URL=https://musicpedia.id

# Port publik nginx. Untuk uji lokal yang port 80/443-nya terpakai:
#   HTTP_PORT=8080 HTTPS_PORT=8443 HTTPS_REDIRECT_PORT=:8443
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_REDIRECT_PORT=

# Backup harian (dibaca scripts/backup.sh). Di produksi, isi salah satu tujuan
# off-site: BACKUP_RCLONE_REMOTE (contoh offsite:musicpedia-backup) atau
# BACKUP_OFFSITE_DIR (direktori NFS/SSHFS di host lain). Tanpa keduanya,
# backup.sh berhenti dengan pesan GAGAL.
BACKUP_DIR=/var/backups/musicpedia
BACKUP_KEEP_DAYS=14
BACKUP_RCLONE_REMOTE=
# BACKUP_OFFSITE_DIR=/mnt/backup-host/musicpedia

# Hanya untuk uji backup/restore terhadap audio di host, bukan produksi.
# AUDIO_HOST_DIR=
